{
  "name": "ytj-enrichment",
  "version": "1.1.0",
  "private": true,
  "description": "Enrich CSV lists of Finnish companies with data from PRH's open YTJ API and map them to customer-register records.",
  "type": "module",
  "main": "src/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/main.js",
    "start:mock": "YTJ_MOCK=1 node src/main.js",
    "enrich": "node src/cli.js",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
